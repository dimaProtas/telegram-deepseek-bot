TELEGRAM_BOT_TOKEN=your_token_here
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7
ALLOWED_USER_IDS=0
ALLOWED_CHAT_IDS=
LOG_LEVEL=info
CONVERSATION_TTL_HOURS=24
OPENCODE_ENDPOINT=http://localhost:8080
OPENCODE_TIMEOUT=600
OPENCODE_WORKSPACE=/workspace
# OPENCODE_DEFAULT_AGENT=general  # Агент по умолчанию для /run (пусто = default opencode)
# Proxy settings (SOCKS5, optional - leave empty for direct connection)
# PROXY_ADDR=proxy.example.com:1080
# PROXY_USERNAME=user
# PROXY_PASSWORD=pass
